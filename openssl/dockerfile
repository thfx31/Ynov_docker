# Étape 1 : partir d'une image légère
FROM alpine:latest

# Étape 2 : installer openssl
RUN apk add --no-cache openssl

# Étape 3 : définir les variables d'environnement par défaut (optionnel)
ENV CERT_CN=localhost \
    CERT_DAYS=365 \
    CERT_KEY_FILE=server.key \
    CERT_CRT_FILE=server.crt

# Étape 4 : définir le répertoire de travail
WORKDIR /certs

# Étape 5 : script d’entrée pour générer le certificat
ENTRYPOINT ["/bin/sh", "-c"]
CMD ["openssl req -x509 -nodes -days $CERT_DAYS -newkey rsa:2048 -keyout /certs/$CERT_KEY_FILE -out /certs/$CERT_CRT_FILE -subj \"/CN=$CERT_CN\""]

